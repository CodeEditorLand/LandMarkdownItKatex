{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": "./",
		"esModuleInterop": true,
		"module": "CommonJS",
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2022"
	},
	"exclude": [
		"node_modules",
		"**/node_modules/*"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src/**/*.ts",
		"types.d.ts",
		"src"
	]
}
